<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!--  This is the file that defines the actual layout and type of the commands. -->

  <!--  This is the file that defines the IDs for all the commands exposed by VisualStudio. -->
  <Extern href="stdidcmd.h" />

  <!--This header contains the command ids for the menus provided by the shell. -->
  <Extern href="vsshlids.h" />

  <!--The Commands section is where commands, menus, and menu groups are defined. -->
  <Commands package="guidCuislVSIXPackage">

    <!-- 菜单组：放在“工具”菜单中 -->
    <Groups>
      <Group guid="guidCuislVSIXCmdSet" id="MyMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <!-- 按钮：一个命令对应一个按钮 -->
    <Buttons>
      <Button guid="guidCuislVSIXCmdSet" id="AlignCommandId" priority="0x0100" type="Button">
        <Parent guid="guidCuislVSIXCmdSet" id="MyMenuGroup" />
        <Icon guid="guidImages" id="bmpPicBlue" />
        <Strings>
          <ButtonText>垂直对齐代码</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidCuislVSIXCmdSet" id="CopyFullPathCommandId" priority="0x0200" type="Button">
        <Parent guid="guidCuislVSIXCmdSet" id="MyMenuGroup" />
        <Icon guid="guidImages" id="bmpPicGreen" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>复制完整路径和行号</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidCuislVSIXCmdSet" id="CopyRelativePathCommandId" priority="0x0200" type="Button">
        <Parent guid="guidCuislVSIXCmdSet" id="MyMenuGroup" />
        <Icon guid="guidImages" id="bmpPicMaroon" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>复制相对路径和行号</ButtonText>
        </Strings>
      </Button>
    </Buttons>

    <!-- 位图：命令图标（strip：位置1=Hello，2~9=八个彩色球） -->
    <Bitmaps>
      <Bitmap guid="guidImages" href="Resources\commands.png" usedList="bmpPicHello,bmpPicRed,bmpPicGreen,bmpPicBlue,bmpPicYellow,bmpPicPurple,bmpPicTeal,bmpPicOrange,bmpPicMaroon" />
    </Bitmaps>
  </Commands>

  <Symbols>
    <!-- This is the package guid. -->
    <GuidSymbol name="guidCuislVSIXPackage" value="{D7293568-A33D-4AA9-ADD1-67076F7B4932}" />

    <!-- This is the guid used to group the menu commands together -->
    <GuidSymbol name="guidCuislVSIXCmdSet" value="{DA6053CE-A84C-43A9-8A58-D8068C7D41BC}">
      <IDSymbol name="MyMenuGroup" value="0x1020" />
      <IDSymbol name="AlignCommandId" value="0x0200" />
      <IDSymbol name="CopyFullPathCommandId" value="0x0300" />
      <IDSymbol name="CopyRelativePathCommandId" value="0x0400" />
    </GuidSymbol>

    <GuidSymbol name="guidImages" value="{08602E4F-530C-4B96-84DC-9EC68FB8F9D2}">
      <IDSymbol name="bmpPicHello" value="1" />
      <IDSymbol name="bmpPicRed" value="2" />
      <IDSymbol name="bmpPicGreen" value="3" />
      <IDSymbol name="bmpPicBlue" value="4" />
      <IDSymbol name="bmpPicYellow" value="5" />
      <IDSymbol name="bmpPicPurple" value="6" />
      <IDSymbol name="bmpPicTeal" value="7" />
      <IDSymbol name="bmpPicOrange" value="8" />
      <IDSymbol name="bmpPicMaroon" value="9" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
