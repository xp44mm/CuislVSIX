<mah:MetroWindow
    x:Class="CuislVSIX.SeparatorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"

    Title="垂直对齐分隔符" Height="125" Width="430" ResizeMode="NoResize"
    ShowInTaskbar="False" WindowStartupLocation="CenterScreen" SizeToContent="Width">
    <mah:MetroWindow.Resources>
        <ResourceDictionary Source="MetroTheme.xaml" />
    </mah:MetroWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Row="0" Grid.Column="0" x:Name="txtName"
                 Height="23" Margin="10,0"  MinWidth="210"
                 VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                 FontFamily="Microsoft YaHei Mono" />
        <Button Grid.Row="0" Grid.Column="1"  x:Name="btnCreate" Content="确定" IsDefault="True" Click="Button_Click"
                Margin="10,0" Width="75" Height="23"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        <CheckBox  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  x:Name="chkRegex"
                  Margin="10,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center" >使用正则表达式</CheckBox>
        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Name="lblTips" Content="提示"
               HorizontalAlignment="Left" Margin="5,0" VerticalAlignment="Bottom" Height="26" />
    </Grid>
</mah:MetroWindow>
